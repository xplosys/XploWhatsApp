# Copy to .env for docker compose. Never commit .env.
# Generate JWT_PRIVATE_KEY_PEM and ENCRYPTION_KEYS with:
#   docker compose run --rm api python -m app.cli generate-secrets

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
FRONTEND_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
# Only needed if the browser calls the API cross-origin (it normally goes through /api on the app origin).
CORS_ALLOWED_ORIGINS=

# PostgreSQL superuser (container init + one-time bootstrap only)
POSTGRES_PASSWORD=change-me-postgres
# Application roles. Use long random passwords outside development.
XPLO_OWNER_PASSWORD=change-me-owner
XPLO_APP_PASSWORD=change-me-app
XPLO_ADMIN_PASSWORD=change-me-admin

# Redis
REDIS_PASSWORD=change-me-redis

# Auth
JWT_PRIVATE_KEY_PEM=
JWT_KEY_ID=k1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Must be true anywhere that is served over HTTPS.
COOKIE_SECURE=false

# Envelope encryption keys: "v1:<base64 32 bytes>[,v2:...]"
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_VERSION=v1

# Email (development uses Mailpit at http://localhost:8025)
EMAIL_BACKEND=smtp
EMAIL_FROM="XploWhatsApp <no-reply@xplowhatsapp.com>"
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

RATE_LIMIT_AUTH_PER_MINUTE=20
SENTRY_DSN=

# --- Meta WhatsApp Cloud API (Phase 2) ---
# From the Meta App Dashboard (App settings > Basic). Leave empty until the app exists:
# the WhatsApp page then explains what is missing instead of offering a broken button.
META_APP_ID=
META_APP_SECRET=
# Any long random string; enter the same value in App Dashboard > WhatsApp > Configuration.
META_WEBHOOK_VERIFY_TOKEN=
# Facebook Login for Business configuration ID for WhatsApp Embedded Signup.
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_EMBEDDED_SIGNUP_VERSION=v4
META_GRAPH_API_VERSION=v25.0
