# Download links for the self-hosted bucket (only when FILES_DOMAIN is set). The links are
# signed for this host name, so Host is passed through unchanged.
server {
    listen 443 ssl;
    http2 on;
    server_name ${FILES_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${FILES_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${FILES_DOMAIN}/privkey.pem;
    include /etc/nginx/xplo/tls-params.inc;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    location / {
        # Downloads only: uploads go from the API to the bucket on the private network.
        limit_except GET HEAD { deny all; }
        limit_req zone=web burst=30 nodelay;
        set $storage http://seaweedfs:8333;
        proxy_pass $storage;
        proxy_set_header Host $host;
        proxy_buffering off;
    }
}
