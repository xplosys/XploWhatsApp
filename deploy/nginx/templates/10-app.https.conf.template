# The app: Next.js for pages, the API directly for /api/ (uploads and webhooks skip Node).
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/xplo/tls-params.inc;

    limit_conn conn 100;
    client_max_body_size ${UPLOAD_LIMIT_MB}m;

    # The app sends its own security headers; Nginx owns HSTS so it is set exactly once.
    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Internal endpoints are never public.
    location = /metrics { return 404; }
    location /health/ { return 404; }

    location /api/v1/auth/ {
        limit_req zone=auth burst=20 nodelay;
        include /etc/nginx/xplo/proxy-api.inc;
    }

    location /api/v1/webhooks/ {
        # Meta and the payment gateways retry on errors; keep their requests flowing.
        client_max_body_size 1m;
        include /etc/nginx/xplo/proxy-api.inc;
    }

    location /api/ {
        limit_req zone=api burst=100 nodelay;
        include /etc/nginx/xplo/proxy-api.inc;
    }

    location /_next/static/ {
        set $frontend http://frontend:3000;
        proxy_pass $frontend;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    }

    location / {
        limit_req zone=web burst=60 nodelay;
        set $frontend http://frontend:3000;
        proxy_pass $frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
